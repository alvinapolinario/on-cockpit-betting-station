# On-Cockpit Betting Station - configuration. Copy to .env and fill in.
# Never commit .env. See README.md -> Deployment.

APP_NAME=GCA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
# Arena name shown in the app, on closing reports and teller statements.
ARENA_NAME="Blueknife Gallera"

# Host ports (docker-compose). Bind the database to localhost only.
APP_PORT=80
WEBSOCKET_PORT=6001
FORWARD_DB_PORT=127.0.0.1:3309
# SSH into the app container (key-only). Use 127.0.0.1:2222 to allow only this machine.
SSH_PORT=2222

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database (the "mysql" service in docker-compose.yml).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sabong_lara_db
DB_USERNAME=sabong_root
# REQUIRED. Long random value: openssl rand -hex 24  (also used as the MariaDB root password)
DB_PASSWORD=

BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Only behind an HTTPS reverse proxy (e.g. a VPS demo): SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=

# Reverse proxy in front of the app. Leave empty at the arena.
# Behind nginx on a VPS (app port bound to 127.0.0.1): TRUSTED_PROXIES=*
TRUSTED_PROXIES=

# Local WebSocket server (laravel-websockets on port 6001). Use random values in production.
PUSHER_APP_ID=local
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- Event closing / sealing (BIR Compliance System) ---
# Unique name of this betting server, e.g. arena01-srv01. Registered on the VPS.
SEAL_SERVER_ID=
# The VPS encryption public key printed by the BIR system's installer (keys are never in git).
SEAL_VPS_PUBLIC_KEY=
# Two-person rule when sealing an event (keep true in production).
SEAL_REQUIRE_SECOND_APPROVER=true
# Sender id for packages reconstructed from old backups (legacy import).
SEAL_LEGACY_SERVER_ID=blueknife-legacy

# --- Database backups ---
BACKUP_REQUIRE_SECOND_APPROVER=true
# TESTING ONLY: allow importing raw .sql dumps. Always refused when APP_ENV=production.
BACKUP_ALLOW_RAW_SQL_IMPORT=false

# --- Betting limits and app sessions ---
BET_MIN=1
BET_MAX=1000000
CASH_MAX=1000000
# Teller / admin app logins expire after this many hours.
API_TOKEN_HOURS=18
# Results can only be declared after betting on the fight is closed.
REQUIRE_CLOSED_BEFORE_RESULT=true
RECEIPT_RANDOM_DIGITS=6
# DEMO ONLY: with no active event, the dashboard shows the latest closed event. Keep false at the arena.
DASHBOARD_SHOW_LAST_EVENT=false
